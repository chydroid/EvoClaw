{
  "mcpServers": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "enabled": true,
      "_comment": "Firecrawl — 网页抓取/爬取/搜索，转 Markdown。每月 1000 次免费调用，无需 API key"
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "enabled": true,
      "_comment": "GitHub — 仓库管理/issue/PR/搜索。需要 Personal Access Token (https://github.com/settings/tokens)"
    },
    "paperjsx": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@paperjsx/mcp-server"],
      "enabled": true,
      "_comment": "PaperJSX — 从 JSON 生成 PPTX/DOCX/XLSX/PDF 文档。纯本地运行，无需 API key"
    }
  }
}
