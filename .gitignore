data/skills/

# bundled 技能运行时生成的 origin.json（每次启动会按当前 skillId/installedAt 重写，
# 导致 git status 噪音；代码运行时若不存在会自动重建，无需版本控制）
packages/skills/bundled/*/origin.json
# 血缘身份 sidecar（首次安装/启动扫描时生成，代码运行时若不存在会自动重建）
packages/skills/bundled/*/.skill_id

# Live runtime config at repo root (use config.example.json for templates)
/config.json
/_config.json

