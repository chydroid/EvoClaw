{
  "name": "@evoclaw/reporting",
  "version": "0.72.2",
  "private": true,
  "description": "EvoClaw 报告生成模块 - HTML/PDF模板/图表/自动发送",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
