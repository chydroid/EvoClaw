<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; background: #f0f2f5; color: #333; margin: 0; padding: 0; }
    .container { max-width: 700px; margin: 20px auto; }
    .card { background: #fff; border-radius: 12px; padding: 24px; margin-bottom: 16px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .card h3 { font-size: 18px; color: #333; margin: 0 0 12px 0; }
    .card .meta { font-size: 13px; color: #888; margin-bottom: 10px; }
    .card .snippet { font-size: 14px; color: #555; line-height: 1.6; }
    .card .categories { margin-top: 8px; display: flex; gap: 6px; flex-wrap: wrap; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 500; }
    .badge.high { background: #ffebee; color: #c62828; }
    .badge.normal { background: #e3f2fd; color: #1565c0; }
    .badge.low { background: #e8f5e9; color: #2e7d32; }
    .badge.category { background: #f3e5f5; color: #7b1fa2; }
    .badge.attachment { background: #fff3e0; color: #e65100; }
    .footer { text-align: center; padding: 20px; color: #aaa; font-size: 12px; }
  </style>
</head>
<body>
  <div class="container">
    <div style="padding: 30px 24px; text-align: center; background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-radius: 12px 12px 0 0;">
      <h1 style="margin:0;font-size:24px;">📬 {{title}}</h1>
      <p style="margin:6px 0 0;opacity:0.8;">{{#if dateRange}}时间范围：{{dateRange}}{{else}}最新邮件摘要{{/if}}</p>
    </div>

    <div style="background:#fff;padding:20px 24px;margin-bottom:16px;border-bottom:1px solid #eee;">
      <strong>总计：</strong> {{totalEmails}} 封邮件
      &nbsp;&nbsp;
      {{#each categoriesBreakdown}}
      <span class="badge category">{{name}} {{count}}</span>
      {{/each}}
    </div>

    {{#each emails}}
    <div class="card">
      <h3>{{subject}}</h3>
      <div class="meta">
        发件人：{{from}} · {{formatDate date}}
      </div>
      <div class="snippet">{{snippet}}</div>
      <div class="categories">
        {{#each categories}}
        <span class="badge category">{{this}}</span>
        {{/each}}
        <span class="badge {{priority}}">{{#if (eq priority "high")}}⚠ 重要{{else if (eq priority "normal")}}📌 普通{{else}}📎 低优先级{{/if}}</span>
        {{#if hasAttachments}}
        <span class="badge attachment">📎 有附件</span>
        {{/if}}
      </div>
    </div>
    {{/each}}

    {{#unless emails.length}}
    <div class="card" style="text-align:center;padding:40px;">
      <p style="color:#999;">暂无新邮件</p>
    </div>
    {{/unless}}

    <div class="footer">
      EcoClaw 自动生成 · {{generatedAt}}
    </div>
  </div>
</body>
</html>