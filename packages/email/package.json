{
  "name": "@evoclaw/email",
  "version": "0.1.0",
  "private": true,
  "description": "EcoClaw Email 邮件模块 - IMAP收信/SMTP发信/邮件分析",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "@evoclaw/security": "workspace:*",
    "mailparser": "^3.7.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^6.4.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}