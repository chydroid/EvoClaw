{
  "name": "@evoclaw/claude-code-tools",
  "version": "1.0.0",
  "private": true,
  "description": "EvoClaw 编程任务调度插件 — 基于Claude Code设计理念的复杂编程项目任务分解、LLM调度与结果整合系统",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "@evoclaw/plugin-sdk": "workspace:*",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}