{
  "name": "@evoclaw/agent",
  "version": "0.73.0",
  "private": true,
  "description": "EvoClaw Agent 调度层 - 任务编排、多代理协同、状态机驱动",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/claude-code-tools": "workspace:*",
    "@evoclaw/core": "workspace:*",
    "@evoclaw/infrastructure": "workspace:*",
    "@evoclaw/memory": "workspace:*",
    "@evoclaw/plugin-sdk": "workspace:*",
    "@evoclaw/security": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@types/uuid": "^9.0.0",
    "p-queue": "^8.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
