{
  "name": "@evoclaw/plugin-sdk",
  "version": "0.74.0",
  "private": true,
  "description": "EvoClaw Plugin SDK — Type-safe extension framework for channels, providers, and tools",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./tool": {
      "types": "./dist/tool.d.ts",
      "default": "./dist/tool.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./channel-runtime": {
      "types": "./dist/channel-runtime.d.ts",
      "default": "./dist/channel-runtime.js"
    },
    "./provider-runtime": {
      "types": "./dist/provider-runtime.d.ts",
      "default": "./dist/provider-runtime.js"
    },
    "./tool-runtime": {
      "types": "./dist/tool-runtime.d.ts",
      "default": "./dist/tool-runtime.js"
    },
    "./approval-runtime": {
      "types": "./dist/approval-runtime.d.ts",
      "default": "./dist/approval-runtime.js"
    },
    "./plugin-entry": {
      "types": "./dist/plugin-entry.d.ts",
      "default": "./dist/plugin-entry.js"
    },
    "./openai-compatible-provider": {
      "types": "./dist/openai-compatible-provider.d.ts",
      "default": "./dist/openai-compatible-provider.js"
    },
    "./providers/deepseek": {
      "types": "./dist/providers/deepseek.d.ts",
      "default": "./dist/providers/deepseek.js"
    },
    "./providers/groq": {
      "types": "./dist/providers/groq.d.ts",
      "default": "./dist/providers/groq.js"
    },
    "./providers/qwen": {
      "types": "./dist/providers/qwen.d.ts",
      "default": "./dist/providers/qwen.js"
    },
    "./providers/mistral": {
      "types": "./dist/providers/mistral.d.ts",
      "default": "./dist/providers/mistral.js"
    },
    "./providers/xai": {
      "types": "./dist/providers/xai.d.ts",
      "default": "./dist/providers/xai.js"
    },
    "./channels/signal": {
      "types": "./dist/channels/signal.d.ts",
      "default": "./dist/channels/signal.js"
    },
    "./channels/irc": {
      "types": "./dist/channels/irc.d.ts",
      "default": "./dist/channels/irc.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.19.19",
    "rimraf": "^6.0.0"
  }
}
