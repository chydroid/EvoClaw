{
  "name": "@evoclaw/gateway",
  "version": "0.73.0",
  "private": true,
  "description": "EvoClaw Gateway 接入层 - 认证鉴权、负载均衡、协议适配",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/agent": "workspace:*",
    "@evoclaw/core": "workspace:*",
    "@evoclaw/infrastructure": "workspace:*",
    "@evoclaw/security": "workspace:*",
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
