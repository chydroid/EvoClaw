{
  "name": "@evoclaw/infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "EvoClaw 基础设施层 - 消息队列、事件总线、文件系统、进程管理",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}