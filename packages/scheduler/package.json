{
  "name": "@evoclaw/scheduler",
  "version": "0.70.3",
  "private": true,
  "description": "EvoClaw 定时任务调度模块 - cron任务管理/持久化/重试",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/node-cron": "^3.0.11",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}