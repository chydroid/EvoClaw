{
  "name": "@evoclaw/memory",
  "version": "0.70.6",
  "private": true,
  "description": "EvoClaw Memory 记忆层 - 短期/长期存储、语义搜索、知识图谱",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "uuid": "^9.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/uuid": "^9.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}