  },
  "dependencies": {
    "@evoclaw/core": "workspace:*",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/uuid": "^9.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}