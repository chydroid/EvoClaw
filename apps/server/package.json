    "@evoclaw/memory": "workspace:*",
    "@evoclaw/security": "workspace:*",
    "@evoclaw/skills": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
