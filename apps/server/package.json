{
  "name": "@evoclaw/server",
  "version": "0.1.1",
  "private": true,
  "description": "EvoClaw 主服务入口 - 组装各层并启动系统",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@evoclaw/agent": "workspace:*",
    "@evoclaw/core": "workspace:*",
    "@evoclaw/email": "workspace:*",
    "@evoclaw/evolution": "workspace:*",
    "@evoclaw/gateway": "workspace:*",
    "@evoclaw/infrastructure": "workspace:*",
    "@evoclaw/memory": "workspace:*",
    "@evoclaw/security": "workspace:*",
    "@evoclaw/skills": "workspace:*",
    "@evoclaw/scheduler": "workspace:*",
    "@evoclaw/reporting": "workspace:*",
    "@evoclaw/intelligence": "workspace:*",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/instrumentation-http": "^0.55.0",
    "@opentelemetry/instrumentation-express": "^0.44.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0"
  }
}