# Node.js 头文件镜像（node-gyp 编译时下载 headers 使用）
disturl=https://npmmirror.com/mirrors/node

# better-sqlite3 预编译二进制镜像（prebuild-install 下载 .node 二进制时使用）
# npmmirror 的 binary 镜像路径为 /-binary/{package-name}
better-sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3

# sharp 预编译二进制 libvips 镜像
sharp_binary_host=https://npmmirror.com/mirrors/sharp
sharp_libvips_binary_host=https://npmmirror.com/mirrors/sharp-libvips

# Electron 镜像（如需要）
electron_mirror=https://npmmirror.com/mirrors/electron/

# better-sqlite3 为 optionalDependency，即使 prebuild+编译都失败也不阻断 pnpm install
