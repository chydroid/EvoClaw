{
  "name": "evoclaw",
  "version": "0.93.1",
  "private": true,
  "description": "EvoClaw - 具备增强式自我进化能力的下一代自主智能体操作系统",
  "scripts": {
    "build": "pnpm -r build",
    "start": "node scripts/launch.mjs server",
    "start:unix": "node scripts/launch.mjs server",
    "start:win": "node scripts/launch.mjs server",
    "dev": "pnpm -r dev",
    "cli": "node scripts/launch.mjs cli",
    "cli:unix": "node scripts/launch.mjs cli",
    "cli:win": "node scripts/launch.mjs cli",
    "test": "node scripts/vitest-runner.mjs",
    "test:watch": "node scripts/vitest-runner.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "osv-check": "npx --yes tsx scripts/osv-check.ts",
    "release:prepare": "node scripts/release-prepare.mjs",
    "lock-deps": "npx --yes tsx scripts/lock-deps.ts",
    "lock-deps:fix": "npx --yes tsx scripts/lock-deps.ts --fix"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract",
      "onnxruntime-node",
      "openclaw",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.19.19",
    "@vitest/coverage-istanbul": "3.1.3",
    "@vitest/coverage-v8": "3.1.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "3.1.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0",
    "@tencent-weixin/openclaw-weixin": "^2.4.4"
  }
}
