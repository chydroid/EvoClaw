{
  "name": "evoclaw",
  "version": "0.66.0",
  "private": true,
  "description": "EvoClaw - 具备增强式自我进化能力的下一代自主智能体操作系统",
  "scripts": {
    "build": "pnpm -r build",
    "start": "chcp 65001 > nul && node --max-old-space-size=4096 --env-file=.env apps/server/dist/index.js",
    "start:unix": "node --max-old-space-size=4096 --env-file=.env apps/server/dist/index.js",
    "dev": "pnpm -r dev",
    "cli": "chcp 65001 > nul && node apps/cli/dist/index.js",
    "cli:unix": "node apps/cli/dist/index.js",
    "test": "node scripts/vitest-runner.mjs",
    "test:watch": "node scripts/vitest-runner.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "esbuild",
      "koffi",
      "msgpackr-extract",
      "onnxruntime-node",
      "openclaw",
      "protobufjs",
      "sharp",
      "tree-sitter-bash"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.19.19",
    "@vitest/coverage-istanbul": "3.1.3",
    "@vitest/coverage-v8": "3.1.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "3.1.3"
  },
  "dependencies": {
    "@tencent-weixin/openclaw-weixin": "^2.4.4"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.10.0"
  }
}