#!/bin/sh
#
# Pre-commit hook for EvoClaw
# Checks for common issues before committing

# Check for secrets in staged files
echo "Checking for secrets..."
if git diff --cached --name-only | xargs grep -l -E "(API_KEY|SECRET|PASSWORD|TOKEN)\s*[:=]\s*['\"][^'\"${" | head -1 | grep -q .; then
    echo "ERROR: Potential secrets found in staged files!"
    echo "Please remove secrets before committing."
    exit 1
fi

# Check for console.log in production code
echo "Checking for console.log..."
if git diff --cached --name-only | grep -E "\.(ts|js)$" | xargs grep -l "console\.log" 2>/dev/null | head -1 | grep -q .; then
    echo "WARNING: console.log found in staged files."
    echo "Consider using Logger instead."
fi

echo "Pre-commit checks passed!"
