# EvoClaw 环境配置

# 服务器配置
EvoClaw_PORT=27788
EvoClaw_HOST=0.0.0.0

# hermes 式软超时预算（毫秒）：长任务到预算后存检查点 + 转后台续跑，
# HTTP 立即返回阶段性回复（⏳），不再让客户端干等任务真跑完。默认 360000（6 分钟）。
# 设 0 禁用整体超时（靠 max_iterations + 用户中断）。
CHAT_TIMEOUT_MS=360000

# JWT 密钥 (生产环境务必改为至少16位随机字符串！)
JWT_SECRET=change-me-to-a-random-secret-min-16-chars

# Web UI 访问令牌 (留空则不启用鉴权；启用时请设置为强随机字符串)
WEB_UI_TOKEN=

# 进化引擎
EvoClaw_EVOLUTION_ENABLED=true

# MCP 协议
EvoClaw_MCP_ENABLED=true

# 外部 MCP Server 消费
# 配置文件位于 data/mcp-servers.json（参考 config/mcp-servers.example.json）
# EvoClaw 会启动配置中声明的 MCP server 进程，通过标准 MCP 协议调用其全部工具
# 支持的 server：firecrawl、brave-search、github、sequential-thinking 等
# 示例配置：cp config/mcp-servers.example.json data/mcp-servers.json

# REST API
EvoClaw_REST_ENABLED=true

# OpenTelemetry Tracing — OTLP HTTP endpoint for trace export (e.g., http://localhost:4318/v1/traces)
EVOCLAW_OTLP_ENDPOINT=

# 技能市场远程注册表 URL（留空使用默认 https://cn.clawhub-mirror.com）
# 与 openclaw 完全兼容，可指向 https://clawhub.ai 或自建镜像
EVOCLAW_MARKETPLACE_REGISTRY_URL=

# ── TTS / STT Provider Registry（Hermes 对齐 Step 5：默认链自动降级，任意一家可用即暴露工具）──
# TTS 链: edge (免费, 需 python edge-tts) → openai → elevenlabs → minimax → mistral → gemini → xai → deepinfra
# STT 链: local (免费, 需 python faster-whisper) → openai → groq → mistral → xai → elevenlabs → deepinfra
# python 引擎（Node 子进程调用）
EDGE_TTS_PYTHON=python3
STT_PYTHON=python3
# 云 key（全部可选；edge/local 无 key 依赖，缺失只是链选跳过该家）
TTS_API_KEY=          # openai /audio/speech（兼容网关可走 TTS_OPENAI_BASE_URL）
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=      # MINIMAX_CN=1 切国内站 api.minimaxi.com
MISTRAL_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
# base url 覆盖（默认指向官方端点）
TTS_OPENAI_BASE_URL=
TTS_XAI_BASE_URL=
TTS_DEEPINFRA_BASE_URL=
ELEVENLABS_BASE_URL=
GEMINI_BASE_URL=
STT_OPENAI_BASE_URL=
STT_GROQ_BASE_URL=
STT_MISTRAL_BASE_URL=
STT_XAI_BASE_URL=
STT_DEEPINFRA_BASE_URL=
# 默认音色/模型覆盖（留空用 provider 默认：edge=en-US-AriaNeural, openai=alloy, elevenlabs=Adam,
# minimax=speech-02-hd/English_expressive_narrator, mistral=voxtral-mini-tts-2603/Paul, gemini=Kore, xai=grok-tts/eve；
# STT 云侧模型（whisper-1/whisper-large-v3-turbo/voxtral-mini-latest 等）各自硬编码默认，暂无统一 env 覆盖）
TTS_MODEL=
TTS_VOICE=

# 每次 agent 任务完成后自动 git commit（默认关闭；共享仓库/并发编辑下不安全）。
# 仅当显式设为 1/true/yes/on 时启用。对齐 hermes：hermes 从不自动提交。
EVOCLAW_AUTO_COMMIT=
