# EvoClaw 环境配置

# 服务器配置
EvoClaw_PORT=27788
EvoClaw_HOST=0.0.0.0

# JWT 密钥 (生产环境务必改为至少16位随机字符串！)
JWT_SECRET=change-me-to-a-random-secret-min-16-chars

# Web UI 访问令牌 (留空则不启用鉴权；启用时请设置为强随机字符串)
WEB_UI_TOKEN=

# 进化引擎
EvoClaw_EVOLUTION_ENABLED=true

# MCP 协议
EvoClaw_MCP_ENABLED=true

# REST API
EvoClaw_REST_ENABLED=true

# OpenTelemetry Tracing — OTLP HTTP endpoint for trace export (e.g., http://localhost:4318/v1/traces)
EVOCLAW_OTLP_ENDPOINT=

# 自动技能扫描间隔（毫秒），默认 300000（5 分钟）
# 之前为 30s/60s，改为 5 分钟以降低磁盘 I/O 压力
EVOCLAW_SKILL_SCAN_INTERVAL_MS=300000

# 技能市场远程注册表 URL（留空使用默认 https://clawhub.ai/api/v1）
# 当 clawhub.ai 不可达或自建 registry 时可覆盖
EVOCLAW_MARKETPLACE_REGISTRY_URL=
