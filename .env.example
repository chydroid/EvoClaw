# EvoClaw 环境配置

# 服务器配置
EvoClaw_PORT=27788
EvoClaw_HOST=0.0.0.0

# JWT 密钥 (生产环境务必改为至少16位随机字符串！)
JWT_SECRET=change-me-to-a-random-secret-min-16-chars

# Web UI 访问令牌 (留空则不启用鉴权；启用时请设置为强随机字符串)
WEB_UI_TOKEN=

# 进化引擎
EvoClaw_EVOLUTION_ENABLED=true

# MCP 协议
EvoClaw_MCP_ENABLED=true

# 外部 MCP Server 消费
# 配置文件位于 data/mcp-servers.json（参考 config/mcp-servers.example.json）
# EvoClaw 会启动配置中声明的 MCP server 进程，通过标准 MCP 协议调用其全部工具
# 支持的 server：firecrawl、brave-search、github、sequential-thinking 等
# 示例配置：cp config/mcp-servers.example.json data/mcp-servers.json

# REST API
EvoClaw_REST_ENABLED=true

# OpenTelemetry Tracing — OTLP HTTP endpoint for trace export (e.g., http://localhost:4318/v1/traces)
EVOCLAW_OTLP_ENDPOINT=

# 技能市场远程注册表 URL（留空使用默认 https://cn.clawhub-mirror.com）
# 与 openclaw 完全兼容，可指向 https://clawhub.ai 或自建镜像
EVOCLAW_MARKETPLACE_REGISTRY_URL=
