# EcoClaw 环境配置

# 服务器配置
ECOCLAW_PORT=17788
ECOCLAW_HOST=0.0.0.0

# JWT 密钥 (生产环境务必改为至少16位随机字符串！)
JWT_SECRET=change-me-to-a-random-secret-min-16-chars

# Web UI 访问令牌 (留空则不启用鉴权)
WEB_UI_TOKEN=ecoclaw-2026

# 进化引擎
ECOCLAW_EVOLUTION_ENABLED=true

# MCP 协议
ECOCLAW_MCP_ENABLED=true

# REST API
ECOCLAW_REST_ENABLED=true

# OpenTelemetry Tracing — OTLP HTTP endpoint for trace export (e.g., http://localhost:4318/v1/traces)
EVOCLAW_OTLP_ENDPOINT=