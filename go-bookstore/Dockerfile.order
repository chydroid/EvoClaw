# Dockerfile for Order Service
FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o order-service ./order-service/

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/order-service .
EXPOSE 50053
CMD ["./order-service"]
