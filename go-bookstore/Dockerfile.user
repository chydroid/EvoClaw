# Dockerfile for User Service
FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o user-service ./user-service/

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/user-service .
EXPOSE 50051
CMD ["./user-service"]
