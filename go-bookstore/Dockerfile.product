# Dockerfile for Product Service
FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o product-service ./product-service/

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/product-service .
EXPOSE 50052
CMD ["./product-service"]
